<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_rotulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Próxima dose"
        android:textColor="@color/widget_apagado"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="08:00"
            android:textColor="@color/widget_tinta"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_progresso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/widget_apagado"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_nomes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="Olmesartana"
        android:textColor="@color/widget_tinta"
        android:textSize="14sp" />

    <Button
        android:id="@+id/widget_tomei"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_botao"
        android:minWidth="96dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Tomei"
        android:textAllCaps="false"
        android:textColor="@color/widget_sobre_botao"
        android:textSize="15sp" />
</LinearLayout>
